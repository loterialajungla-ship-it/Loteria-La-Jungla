# Pooled (Neon pooler): queries en runtime (Next.js / Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require"

# Directa (sin pooling): solo migraciones / prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# npm run dev: wrapper seguro. Si DATABASE_URL/DIRECT_URL apuntan a producción
# o recovery, aborta y pide npm run dev:recovery (o npm run dev:test).
# No uses `next dev` a pelo contra el .env de producción.

# --- TESTS DE INTEGRACIÓN / ACCEPTANCE (PostgreSQL aislada) ---
# Obligatoria para: npm run test:integration / npm run test:acceptance
# Endpoint Neon autorizado (obligatorio): ep-muddy-fire-b44816w0
# PROHIBIDO: ep-spring-silence-b40xhu8w (prod), ep-old-snow-b4sqg9p9 (recovery),
#            ep-delicate-river-b4n3lose (dev-from-recovery; solo npm run dev:recovery)
# El runner aborta si el endpoint no es el de TEST o coincide con prod/recovery/dev.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-muddy-fire-b44816w0…/neondb?sslmode=require"
# Luego: npm run seed:manual-test && npm run dev:test
# (dev:test inyecta TEST en el proceso hijo; no edita este archivo)

# --- DESARROLLO LOCAL SOBRE RAMA Neon dev-from-recovery ---
# NO pegues estas URLs en DATABASE_URL/DIRECT_URL de este archivo si aún apuntan a producción.
# Arrancar con: npm run dev:recovery
# El runner valida el endpoint ep-delicate-river-b4n3lose y solo entonces inyecta
# DATABASE_URL/DIRECT_URL en el proceso hijo de Next.js (no modifica este archivo ni .env).
#
# Opción A — sesión PowerShell (prioridad máxima si ya están definidas):
#   $env:DEV_FROM_RECOVERY_DATABASE_URL="…"
#   $env:DEV_FROM_RECOVERY_DIRECT_URL="…"
#
# Opción B — archivo local ignorado por Git (recomendado para no reintroducir en cada sesión):
#   Crear manualmente en la raíz del proyecto: .env.recovery.local
#   Contenido EXCLUSIVO (solo estas dos claves; NUNCA DATABASE_URL ni DIRECT_URL):
#     DEV_FROM_RECOVERY_DATABASE_URL="postgresql://USER:PASSWORD@ep-delicate-river-b4n3lose-pooler…/neondb?sslmode=require"
#     DEV_FROM_RECOVERY_DIRECT_URL="postgresql://USER:PASSWORD@ep-delicate-river-b4n3lose…/neondb?sslmode=require"
#   Precedencia: sesión > .env.recovery.local > error si faltan.
#   npm run dev NO lee este archivo. .gitignore ya excluye .env.* (salvo .env.example).
#
# Placeholders (no uses valores reales en este example):
# DEV_FROM_RECOVERY_DATABASE_URL="postgresql://USER:PASSWORD@ep-delicate-river-b4n3lose-pooler…/neondb?sslmode=require"
# DEV_FROM_RECOVERY_DIRECT_URL="postgresql://USER:PASSWORD@ep-delicate-river-b4n3lose…/neondb?sslmode=require"

# --- PRUEBAS MANUALES (solo TEST_DATABASE_URL; npm run seed:manual-test) ---
# Credenciales locales; NO commitear valores reales.
# MANUAL_TEST_ADMIN_USER=manual_admin
# MANUAL_TEST_ADMIN_PASSWORD=
# MANUAL_TEST_VENDOR_USER=manual_vendedor
# MANUAL_TEST_VENDOR_PASSWORD=
# MANUAL_TEST_PUBLIC_BASE_URL=http://localhost:3000
# Ver docs/manual-test-environment.md
#
# Solo ADMIN en TEST (sin tickets/resultados): npm run ensure:test-admin
#   $env:ENSURE_TEST_ADMIN="1"
#   # MANUAL_TEST_ADMIN_USER + MANUAL_TEST_ADMIN_PASSWORD + TEST_DATABASE_URL
#   # Endpoint obligatorio: ep-muddy-fire-b44816w0. No toca bootstrap-admin.

# --- AUTH (UsuarioSesion / lj_session) ---
# Duración de cookie lj_session / UsuarioSesion (horas). Default: 12.
AUTH_SESSION_HOURS=12

# --- CRON resultados automáticos (servidor a servidor; NUNCA en el frontend) ---
# Mismo valor en Vercel Production → Settings → Environment Variables
# y (si aplica) en Vercel → Cron → Authorization Bearer.
# Schedulers externos: header Authorization: Bearer <CRON_SECRET>
# o x-cron-secret: <CRON_SECRET>
# CRON_SECRET=


# --- BOOTSTRAP del primer ADMIN (scripts aislados; no autentican en runtime) ---
# Usuario del primer ADMIN. Default: admin
ADMIN_BOOTSTRAP_USER=admin
# Contraseña solo para scripts bootstrap. Se hashea; NUNCA se imprime.
ADMIN_BOOTSTRAP_PASSWORD=

# A) Desarrollo recuperado — npm run bootstrap:admin
#    Solo ep-delicate-river-b4n3lose. NUNCA producción ni TEST.
# BOOTSTRAP_TARGET=dev-from-recovery
# DATABASE_URL / DIRECT_URL → ep-delicate-river-b4n3lose
#   $env:BOOTSTRAP_TARGET="dev-from-recovery"
#   npm run bootstrap:admin

# B) Producción — npm run bootstrap:admin:production (SOLO con autorización explícita)
#    Orden: backup → migrate deploy (incl. CREAR_ADMIN) → verificar schema → este script.
#    Retirar ADMIN_BOOTSTRAP_* y CONFIRM_PRODUCTION_BOOTSTRAP tras el éxito.
# BOOTSTRAP_TARGET=production
# CONFIRM_PRODUCTION_BOOTSTRAP=I_UNDERSTAND_THIS_WRITES_PRODUCTION
# DATABASE_URL / DIRECT_URL → endpoint PRODUCTION allowlisted (mismo ep-…)
# NUNCA usar seed:manual-test ni ensure:test-admin contra producción.

# --- prisma db seed (política cerrada) ---
# Los runners NO usan prisma/seed.ts. Solo con opt-in explícito a TEST:
#   $env:PRISMA_SEED_TARGET="test"
#   # DATABASE_URL/DIRECT_URL = ep-muddy-fire-b44816w0
#   npx prisma db seed
#
# Variables retiradas del runtime (eliminar del entorno de producción):
#   ADMIN_PASSWORD
#   ADMIN_SESSION_SECRET

generator client {

  provider      = "prisma-client-js"

  binaryTargets = ["native", "rhel-openssl-3.0.x"]

}



datasource db {

  provider  = "postgresql"

  url       = env("DATABASE_URL")

  directUrl = env("DIRECT_URL")

}



model Animal {

  numero     String        @id // "0", "00", "01"..."36" — string, NUNCA Int

  nombre     String

  imagen     String?

  resultados Resultado[]

  resultadosProgramados ResultadoProgramado[]

  lineas     TicketLinea[] // apuestas históricas que referencian este animal

}



enum OrigenResultado {

  MANUAL

  AUTOMATICO

}



model Resultado {

  id        String          @id @default(cuid())

  fecha     DateTime        @db.Date

  hora      Int // hora del sorteo, 9 a 19 (11 sorteos/día, uno cada hora)

  numero    String

  animal    Animal          @relation(fields: [numero], references: [numero])

  /// MANUAL = cargado por ADMIN; AUTOMATICO = generado al llegar la hora sin resultado.

  origen    OrigenResultado @default(MANUAL)

  createdAt DateTime        @default(now())

  /// Como máximo una programación que materializó este resultado.
  programacion ResultadoProgramado?



  @@unique([fecha, hora]) // evita cargar dos veces el mismo sorteo del día

}



/// Estados de una selección admin previa a la publicación.
enum EstadoResultadoProgramado {
  PENDIENTE
  PUBLICADO
  CANCELADO
  SUPERSEDED
}



/// Selección de animal para un sorteo futuro (no publicada; no cierra venta).
model ResultadoProgramado {
  id          String                   @id @default(cuid())
  fecha       DateTime                 @db.Date
  hora        Int
  numero      String
  animal      Animal                   @relation(fields: [numero], references: [numero])
  estado      EstadoResultadoProgramado @default(PENDIENTE)
  /// Set al materializar en Resultado; null mientras está pendiente/cancelada.
  resultadoId String?                  @unique
  resultado   Resultado?               @relation(fields: [resultadoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById String
  createdBy   Usuario                  @relation("ResultadoProgramadoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([fecha, hora])
  @@index([estado, fecha])
  @@index([createdById, createdAt])
}



/// Configuración global del negocio (p. ej. MULTIPLICADOR_PREMIO = 30).

model ConfigNegocio {

  clave     String   @id

  valorInt  Int

  updatedAt DateTime @updatedAt

}



/// Contador diario para numeroVisible (usar FOR UPDATE en la TX de emisión).

model TicketCounter {

  fechaJuego   DateTime @id @db.Date

  ultimoNumero Int      @default(0)

}



enum EstadoTicket {

  EMITIDO

  ANULADO

}



enum RolUsuario {

  ADMIN

  VENDEDOR

}



/// Cuenta de acceso (ADMIN o VENDEDOR). Soft-delete vía activo=false.

/// No se crean usuarios en seed; el ADMIN inicial se provisionará en una fase posterior.

model Usuario {

  id           String          @id @default(cuid())

  nombre       String

  /// Identificador de login (único).

  usuario      String          @unique

  /// Hash de contraseña (nunca texto plano).

  passwordHash String

  rol          RolUsuario

  activo       Boolean         @default(true)

  createdAt    DateTime        @default(now())

  updatedAt    DateTime        @updatedAt

  lastLoginAt  DateTime?

  sesiones     UsuarioSesion[]

  ticketsVendidos Ticket[]     @relation("TicketVendedor")

  ticketsAnulados Ticket[]     @relation("TicketAnuladoPor")

  auditorias   Auditoria[]

  resultadosProgramadosCreados ResultadoProgramado[] @relation("ResultadoProgramadoCreatedBy")

  /// Cuenta de créditos del vendedor (1:1). Ausente hasta el primer ensure/asignación.
  creditoCuenta VendedorCreditoCuenta?

  /// Movimientos de crédito en los que este usuario actuó como ADMIN.
  creditoMovimientosComoActor CreditoMovimiento[] @relation("CreditoMovimientoActorAdmin")

  @@index([rol, activo])

}



/// Sesión autenticada. La cookie httpOnly guardará el token; aquí solo su hash.

model UsuarioSesion {

  id         String   @id @default(cuid())

  usuarioId  String

  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tokenHash  String   @unique

  expiresAt  DateTime

  createdAt  DateTime @default(now())

  lastUsedAt DateTime?



  @@index([usuarioId])

  @@index([expiresAt])

}



enum AccionAuditoria {

  LOGIN

  LOGOUT

  CREAR_TICKET

  ANULAR_TICKET

  CREAR_VENDEDOR

  ACTIVAR_VENDEDOR

  DESACTIVAR_VENDEDOR

  RESET_PASSWORD

  CAMBIAR_PASSWORD

  CREAR_RESULTADO

  MODIFICAR_RESULTADO

  /// Provisionamiento del primer ADMIN (bootstrap de producción / sistema).
  CREAR_ADMIN

  /// Programación pendiente de un animal para una franja futura.
  PROGRAMAR_RESULTADO

  /// Cambio del animal en una programación aún PENDIENTE.
  MODIFICAR_PROGRAMACION

  /// Cancelación de una programación aún PENDIENTE.
  CANCELAR_PROGRAMACION

}



enum EntidadAuditoria {

  TICKET

  USUARIO

  RESULTADO

  AUTH

  /// Selección admin previa a publicación (ResultadoProgramado).
  RESULTADO_PROGRAMADO

}



/// Historial de acciones sensibles (sin secretos). Sin borrado automático.

model Auditoria {

  id        String            @id @default(cuid())

  /// NULL = evento de sistema (p. ej. resultado AUTOMATICO vía cron).

  usuarioId String?

  usuario   Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  accion    AccionAuditoria

  entidad   EntidadAuditoria

  entidadId String

  /// JSON de negocio no sensible. Nunca passwords/tokens/hashes.

  detalle   String?

  createdAt DateTime          @default(now())



  @@index([createdAt])

  @@index([usuarioId, createdAt])

  @@index([accion, createdAt])

  @@index([entidad, createdAt])

  @@index([entidadId, createdAt])

}



model Ticket {

  id                String       @id @default(cuid())

  numeroVisible     String       @unique

  codigoPublico     String       @unique

  fechaJuego        DateTime     @db.Date

  /// Usuario VENDEDOR que emitió el ticket. NULL en tickets históricos pre-Usuario.

  vendedorId        String?

  vendedor          Usuario?     @relation("TicketVendedor", fields: [vendedorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt         DateTime     @default(now())

  updatedAt         DateTime     @updatedAt

  totalApostado     Decimal      @db.Decimal(12, 2)

  estado            EstadoTicket @default(EMITIDO)

  anuladoAt         DateTime?

  /// Usuario ADMIN que anuló. NULL en anulaciones históricas pre-Usuario.

  anuladoPorId      String?

  anuladoPor        Usuario?     @relation("TicketAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  motivoAnulacion   String?

  /// Snapshot del multiplicador al emitir (p. ej. 30). Liquidación usa este valor, no el global.

  multiplicadorUsado Int

  /// Clave de idempotencia del cliente (UUID). NULL en tickets históricos.

  idempotencyKey         String?  @unique

  /// SHA-256 del payload canónico (fechaJuego + líneas). Detecta reuso con body distinto.

  idempotencyRequestHash String?

  lineas            TicketLinea[]

  /// Movimientos de crédito ligados a este ticket (consumo / devolución).
  creditoMovimientos CreditoMovimiento[]

  @@index([fechaJuego])

  @@index([estado, fechaJuego])

  @@index([vendedorId, createdAt])

}



model TicketLinea {

  id                    String   @id @default(cuid())

  ticketId              String

  ticket                Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Denormalizada del ticket: misma fechaJuego; acelera exposición/liquidación.

  fechaJuego            DateTime @db.Date

  hora                  Int

  numeroAnimal          String

  animal                Animal   @relation(fields: [numeroAnimal], references: [numero], onDelete: Restrict, onUpdate: Cascade)

  /// Nombre del animal al momento de la venta (histórico del ticket).

  nombreAnimalSnapshot  String

  importe               Decimal  @db.Decimal(12, 2)

  createdAt             DateTime @default(now())



  @@unique([ticketId, hora, numeroAnimal])

  @@index([fechaJuego, hora, numeroAnimal])

  @@index([fechaJuego, hora])

}



/// Tipos de movimiento del libro de créditos de vendedores (inmutable).
enum TipoCreditoMovimiento {
  ASIGNACION
  RETIRO
  CONSUMO_VENTA
  DEVOLUCION_ANULACION
  CORRECCION
}



/// Saldo materializado por vendedor. Proyección del libro CreditoMovimiento.
/// Coherencia: saldoDisponible debe igualar la suma neta de movimientos
/// (ASIGNACION/DEVOLUCION/CORRECCION+ − RETIRO/CONSUMO/CORRECCION−).
model VendedorCreditoCuenta {
  vendedorId      String   @id
  vendedor        Usuario  @relation(fields: [vendedorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Nunca negativo. Decimal monetario (misma precisión que Ticket.totalApostado).
  saldoDisponible Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movimientos CreditoMovimiento[]
}



/// Libro mayor inmutable de créditos. No se borran ni alteran filas en operaciones normales.
model CreditoMovimiento {
  id         String               @id @default(cuid())
  vendedorId String
  cuenta     VendedorCreditoCuenta @relation(fields: [vendedorId], references: [vendedorId], onDelete: Restrict, onUpdate: Cascade)

  tipo           TipoCreditoMovimiento
  /// Siempre > 0. El signo lo determina el tipo (y el efecto en CORRECCION vía saldos).
  importe        Decimal @db.Decimal(12, 2)
  saldoAnterior  Decimal @db.Decimal(12, 2)
  saldoPosterior Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  /// ADMIN que asignó/retiró/corrigió. Null en CONSUMO_VENTA / DEVOLUCION_ANULACION del sistema.
  actorAdminId String?
  actorAdmin   Usuario? @relation("CreditoMovimientoActorAdmin", fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Devolución o corrección: apunta al movimiento que se compensa.
  movimientoOrigenId String?
  movimientoOrigen   CreditoMovimiento?  @relation("CreditoMovimientoCadena", fields: [movimientoOrigenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movimientosHijos   CreditoMovimiento[] @relation("CreditoMovimientoCadena")

  motivo String?

  /// Idempotencia de operaciones administrativas (asignar/retirar/corregir).
  idempotencyKey String? @unique

  /// Un consumo y una devolución por ticket (NULL ticketId permitido varias veces en PG).
  @@unique([ticketId, tipo])
  @@index([vendedorId, createdAt])
  @@index([tipo, createdAt])
  @@index([movimientoOrigenId])
  /// Además (solo SQL migración): UNIQUE parcial devolución por movimientoOrigenId.
}



/// Configuración singleton del control de créditos (id fijo = 1).
/// controlActivo=false (default): se pueden preparar saldos sin consumir en ventas.
/// inicioEn: instante UTC inequívoco; la venta sujeta usa Ticket.createdAt >= inicioEn
/// (no fechaJuego). Interpretación de “día” en America/Caracas al elegir el instante
/// (p. ej. medianoche Caracas → convertir a UTC al guardar). Null = sin inicio → no hay consumo.
model CreditosConfig {
  id Int @id @default(1)

  controlActivo Boolean @default(false)

  /// Instante absoluto (timestamptz). Null hasta configuración expresa del ADMIN.
  inicioEn DateTime?

  umbralSaldoBajo Decimal? @db.Decimal(12, 2)

  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
}

